# Local database path for the application runtime
DATABASE_URL=file:./data/app.sqlite

# Optional alternate path if the implementation prefers explicit filesystem config
SQLITE_PATH=./data/app.sqlite

# Directory used for uploaded phone SQLite files
UPLOADS_DIR=./data/uploads

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs or user IDs allowed to use the bot
TELEGRAM_ALLOWED_IDS=

# Exact conto values allowed for bank statement PDF imports
BANK_STATEMENT_ALLOWED_CONTI=
